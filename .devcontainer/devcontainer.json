{
  "name": "FarmaRed - Base de Datos II",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/farmared",
  "shutdownAction": "stopCompose",
  "postCreateCommand": "python scripts/inicializar_mongo.py && python scripts/verificar_entorno.py",
  "customizations": {
